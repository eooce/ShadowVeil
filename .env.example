# ShadowVeil server configuration
# Copy to .env and adjust as needed. All values have sane defaults.

# HTTP port
PORT=3000

# SQLite database file path (relative to the project root)
DB_PATH=data/shadowveil.db

# Anonymous requests per minute, per IP
ANON_RATE_LIMIT=10

# Authenticated requests per minute, per API key
KEY_RATE_LIMIT=100

# Authenticated requests per day, per API key
KEY_DAILY_QUOTA=5000

# API keys that may be issued per minute, per IP
KEY_ISSUE_RATE_LIMIT=5

# Max accepted source code size in bytes (default 200KB)
MAX_CODE_BYTES=204800

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# development | production (production disables pretty logs)
NODE_ENV=development
